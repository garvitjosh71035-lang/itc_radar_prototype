# PACE Prototype Environment Variables
# Copy this file to .env and fill in your values

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://pace_user:pace_password@localhost:5432/pace_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
ENVIRONMENT=development
DEBUG=true

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Data Sources
OVERTURE_MAPS_VERSION=2026-08-19.0
UN_COMTRADE_API_KEY=your_api_key_here  # Optional for Comtrade
DGCI_S_DATA_PATH=./data/dgci_trade_stats.csv

# Thresholds (Stage-1 anchors from workflow.md)
D1_PRICE_THRESHOLD_FLAG=3.5
D1_PRICE_THRESHOLD_STRONG=5.0
D2A_DENSITY_THRESHOLD_FLAG=3.0
D2A_DENSITY_THRESHOLD_STRONG=4.5
D3_ENTITY_DENSITY_PER_M2=0.02  # 1 GSTIN per 50 m²
D4_CASH_TO_ITC_RATIO_THRESHOLD=0.02

# Geocoding
GEOCODE_JOIN_TOLERANCE_BUILDING=10
GEOCODE_JOIN_TOLERANCE_STREET=30
CLUSTER_DISSOLVE_BUFFER=5

# Fraud Prevalence
ASSUMED_FRAUD_PREVALENCE=0.02

# Render.com Production URLs (set in Render dashboard)
RENDER_BACKEND_URL=https://pace-backend.onrender.com
RENDER_FRONTEND_URL=https://pace-frontend.onrender.com
